{
  "name": "Clássico Bi-Wheel",
  "slug": "classic",
  "version": "1.0",
  "description": "Tema bi-wheel para sobreposição de dois mapas.",

  "canvas": {
    "viewBoxWidth": 1000,
    "viewBoxHeight": 1414,
    "backgroundColor": "#ffffff"
  },

  "modules": {
    "chartInfo": true,
    "logo": true,
    "footerText": false
  },

  "layout": {
    "wheel": {
      "centerX": 500,
      "centerY": 475,
      "scale": 0.80
    },
    "header": {
      "innerX": 50,
      "outerX": 430,
      "y": 40
    },
    "crossAspectGrid": {
      "x": 50,
      "y": 885,
      "cellSize": 28,
      "summaryWidth": 165
    },
    "footer": {
      "text": "Mapa calculado via Lunar Base Astrology — Todos os direitos reservados."
    }
  },

  "axes": {
    "showMarkers": true,
    "distance": 468,
    "mode": "auto",
    "fontSize": 13,
    "fontWeight": "bold",
    "color": "#38bdf8",
    "showTicks": true,
    "ticksInnerRadius": 448,
    "ticksOuterRadius": 456,
    "tickStrokeWidth": 2.0,
    "labels": {
      "asc": "ASC",
      "dsc": "DSC",
      "mc": "MC",
      "ic": "FC"
    },
    "images": {
      "asc": null,
      "dsc": null,
      "mc": null,
      "ic": null
    }
  },

  "assets": {
    "base": "base-biwheel.svg",
    "background": null
  },

  "planets": {
    "showDegrees": true,
    "showRetrograde": true
  },

  "typography": {
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;600&display=swap",
    "fontFamily": "'Inter', sans-serif",
    "headingFontFamily": "'Cormorant Garamond', Georgia, serif",
    "monoFontFamily": "monospace"
  },

  "bands": [
    {
      "name": "sign_segments",
      "innerRadius": 296.25,
      "outerRadius": 375,
      "opacity": 0.25,
      "eclipticOffset": 0,
      "colors": [
        "#f87171", "#fb923c", "#facc15", "#4ade80",
        "#2dd4bf", "#38bdf8", "#818cf8", "#c084fc",
        "#f472b6", "#94a3b8", "#a3e635", "#fb7185"
      ]
    },
    {
      "name": "inner_planets_bg",
      "innerRadius": 145,
      "outerRadius": 276.25,
      "opacity": 0.14,
      "eclipticOffset": 0,
      "colors": [
        "#cbd5e1"
      ]
    },
    {
      "name": "outer_planets_bg",
      "innerRadius": 400,
      "outerRadius": 470,
      "opacity": 0.10,
      "eclipticOffset": 0,
      "colors": [
        "#cbd5e1"
      ]
    }
  ],

  "radii": {
    "signsDistance": 335.6,
    "housesInnerRadius": 145,
    "housesOuterRadius": 276.25,
    "aspectsInnerRadius": 144
