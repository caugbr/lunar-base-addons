  },

  "dimensions": {
    "signWidth": 42,
    "signHeight": 42
  },

  "houses": {
    "showLines": true,
    "strokeWidth": 1.0,
    "axisStrokeWidth": 2.0,
    "color": "#475569",
    "axisColor": "#38bdf8",
    "showNumbers": true,
    "numberColor": "#64748b"
  },

  "aspects": {
    "showLines": true,
    "showAngleLines": false,
    "showNodeLines": false,
    "strokeWidth": 1.4
