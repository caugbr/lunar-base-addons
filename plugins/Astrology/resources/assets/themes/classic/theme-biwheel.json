{
  "name": "Clássico Bi-Wheel",
  "slug": "classic",
  "version": "1.0",
  "description": "Tema Clássico bi-wheel para exibir dois mapas.",

  "canvas": {
    "viewBoxWidth": 1000,
    "viewBoxHeight": 1414,
    "backgroundColor": "#ffffff"
  },

  "modules": {
    "chartInfo": true,
    "logo": true,
    "footerText": false
  },

  "layout": {
    "wheel": {
      "centerX": 500,
      "centerY": 475,
      "width": 800,
      "height": 800,
      "scale": 0.6
    },
    "header": {
      "innerX": 50,
      "outerX": 430,
      "y": 40
    },
    "crossAspectGrid": {
      "x": 50,
      "y": 885,
      "cellSize": 28,
      "summaryWidth": 165
    },
    "footer": {
      "text": "Mapa calculado via Lunar Apps"
    }
  },

  "axes": {
    "showMarkers": true,
    "distance": 400,
    "mode": "auto",
    "fontSize": 13,
    "fontWeight": "bold",
    "color": "#38bdf8",
    "showTicks": true,
    "ticksInnerRadius": 378,
    "ticksOuterRadius": 385,
    "tickStrokeWidth": 1.6,
    "labels": {
      "asc": "ASC",
      "dsc": "DSC",
      "mc": "MC",
      "ic": "FC"
    },
    "images": {
      "asc": null,
      "dsc": null,
      "mc": null,
      "ic": null
    }
  },

  "assets": {
    "base": "base-biwheel.svg",
    "background": null
  },

  "planets": {
    "showDegrees": true,
    "showRetrograde": true
  },

  "typography": {
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;600&display=swap",
    "fontFamily": "'Inter', sans-serif",
    "headingFontFamily": "'Cormorant Garamond', Georgia, serif",
    "monoFontFamily": "monospace"
  },

  "bands": [
    {
      "name": "sign_segments",
      "innerRadius": 237,
      "outerRadius": 300,
      "opacity": 0.25,
      "eclipticOffset": 0,
      "colors": [
        "#f87171", "#fb923c", "#facc15", "#4ade80",
        "#2dd4bf", "#38bdf8", "#818cf8", "#c084fc",
        "#f472b6", "#94a3b8", "#a3e635", "#fb7185"
      ]
    },
    {
      "name": "inner_planets_bg",
      "innerRadius": 116,
      "outerRadius": 221,
      "opacity": 0.14,
      "eclipticOffset": 0,
      "colors": [
        "#cbd5e1"
      ]
    },
    {
      "name": "outer_planets_bg",
      "innerRadius": 320,
      "outerRadius": 376,
      "opacity": 0.10,
      "eclipticOffset": 0,
      "colors": [
        "#cbd5e1"
      ]
    }
  ],

  "radii": {
    "signsDistance": 268.5,
    "housesInnerRadius": 116,
    "housesOuterRadius": 221,
    "aspectsInnerRadius": 115
  },

  "rings": {
    "inner": {
      "planetsDistance": 192,
      "ticksInnerRadius": 214,
      "ticksOuterRadius": 221,
      "guideAnchorOffset": 11,
      "planetWidth": 26,
      "planetHeight": 26,
      "degreeFontSize": 12,
      "degreeOffset": 22,
      "degreeMinuteSpace": 3,
      "retrogradeFontSize": 9.5,
      "retrogradeRightGap": 8,
      "retrogradeTopGap": -9,
      "labelDirection": "inward",
      "minSeparationDeg": 9.0
    },
    "outer": {
      "planetsDistance": 362,
      "ticksInnerRadius": 311,
      "ticksOuterRadius": 318,
      "guideAnchorOffset": -11,
      "planetWidth": 24,
      "planetHeight": 24,
      "degreeFontSize": 11,
      "degreeOffset": 20,
      "degreeMinuteSpace": 3,
      "retrogradeFontSize": 9,
      "retrogradeRightGap": 8,
      "retrogradeTopGap": -8,
      "labelDirection": "inward",
      "minSeparationDeg": 5.5,
      "showAngleMarkers": true,
      "showHouseTicks": false,
      "angleMarkers": {
        "distance": 394,
        "ticksInnerRadius": 376,
        "ticksOuterRadius": 384
      }
    }
  },

  "dimensions": {
    "signWidth": 36,
    "signHeight": 36
  },

  "houses": {
    "showLines": true,
    "strokeWidth": 1.0,
    "axisStrokeWidth": 1.8,
    "color": "#475569",
    "axisColor": "#38bdf8",
    "showNumbers": true,
    "numberColor": "#64748b",
    "numberSize": 12,
    "degSize": 10
  },

  "aspects": {
    "showLines": true,
    "showAngleLines": false,
    "showNodeLines": false,
    "strokeWidth": 1.2
  }
}
