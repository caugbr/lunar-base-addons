{
  "name": "Clássico",
  "slug": "classic",
  "version": "2.0",
  "author": "Lunar Base",
  "description": "Tema padrão do sistema.",

  "canvas": {
    "viewBoxWidth": 1000,
    "viewBoxHeight": 1414,
    "backgroundColor": "#ffffff"
  },

  "modules": {
    "chartInfo": true,
    "logo": true,
    "footerText": false
  },

  "layout": {
    "wheel": {
      "centerX": 500,
      "centerY": 500,
      "width": 850,
      "height": 850
    },
    "aspectGrid": {
      "x": 50,
      "y": 940,
      "cellSize": 34
    },
    "elementsQualities": {
      "x": 620,
      "y": 940
    },
    "footer": {
      "text": "Mapa calculado via Lunar Base Astrology — Todos os direitos reservados."
    }
  },

  "axes": {
    "showMarkers": true,
    "distance": 428,
    "mode": "auto",
    "fontSize": 14,
    "fontWeight": "bold",
    "color": "#38bdf8",
    "showTicks": true,
    "ticksInnerRadius": 381,
    "ticksOuterRadius": 410,
    "tickStrokeWidth": 1.8,
    "labels": {
      "asc": "ASC",
      "dsc": "DSC",
      "mc": "MC",
      "ic": "FC"
    },
    "images": {
      "asc": null,
      "dsc": null,
      "mc": null,
      "ic": null
    }
  },

  "assets": {
    "base": "base.svg",
    "background": null,
    "logo": "logo.jpg",
    "planetsDir": "planets/",
    "signsDir": "signs/",
    "extension": "svg"
  },

  "planets": {
    "showDegrees": true,
    "showRetrograde": true
  },

  "typography": {
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;600&display=swap",
    "fontFamily": "'Inter', sans-serif",
    "headingFontFamily": "'Cormorant Garamond', Georgia, serif",
    "monoFontFamily": "monospace"
  },

  "bands": [
    {
      "name": "sign_segments",
      "innerRadius": 311,
      "outerRadius": 381,
      "opacity": 0.25,
      "eclipticOffset": 0,
      "colors": [
        "#f87171", "#fb923c", "#38bdf8", "#4ade80",
        "#f87171", "#fb923c", "#38bdf8", "#4ade80",
        "#f87171", "#fb923c", "#38bdf8", "#4ade80"
      ]
    },
    {
      "name": "planets_bg",
      "innerRadius": 121,
      "outerRadius": 294,
      "opacity": 0.15,
      "eclipticOffset": 0,
      "colors": [
        "#cbd5e1"
      ]
    }
  ],

  "radii": {
    "signsDistance": 344,
    "ticksDistance": 293,
    "ticksLength": 7,
    "planetsDistance": 264,
    "housesInnerRadius": 123,
    "housesOuterRadius": 295,
    "aspectsInnerRadius": 122
  },

  "houses": {
    "showLines": true,
    "strokeWidth": 1.0,
    "axisStrokeWidth": 1.8,
    "color": "#475569",
    "axisColor": "#38bdf8",
    "showNumbers": true,
    "numberColor": "#64748b",
    "numberSize": 13,
    "degSize": 10
  },

  "dimensions": {
    "signWidth": 42,
    "signHeight": 42,
    "planetWidth": 34,
    "planetHeight": 34,
    "planetDegreeFontSize": 15,
    "planetDegreeOffset": 29,
    "retrogradeFontSize": 11,
    "retrogradeRightGap": 10,
    "retrogradeTopGap": -11,
    "degreeMinuteSpace": 4
  },

  "aspects": {
    "showLines": true,
    "showAngleLines": false,
    "showNodeLines": false,
    "strokeWidth": 1.3,
    "colors": {
      "conjunction": "#38bdf8",
      "opposition": "#ef4444",
      "trine": "#10b981",
      "square": "#f87171",
      "sextile": "#60a5fa",
      "quincunx": "#a855f7",
      "semisquare": "#fb923c",
      "sesquiquadrate": "#fb923c",
      "semisextile": "#94a3b8"
    }
  }
}
